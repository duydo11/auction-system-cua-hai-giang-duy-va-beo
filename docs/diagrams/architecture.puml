@startuml
' Architecture overview - current codebase
skinparam componentStyle rectangle
left to right direction

package "Client module (JavaFX)" {
  [FXML Views] as Views
  [Controllers] as Controllers
  [SceneNavigator] as Navigator
  [ClientProtocolHandler] as CPH
  [SocketClient] as SC
  [SessionContext] as Session
  [AuctionCache] as Cache
  [RealtimeAuctionBus] as Bus

  Views --> Controllers
  Controllers --> Navigator
  Controllers --> CPH
  Controllers --> Session
  Controllers --> Cache
  SC --> Bus : dispatch push
  Bus --> Controllers : notify UI listeners
}

package "Shared module" {
  [Models] as Models
  [Message / MessageType] as Protocol
  [ItemFactory] as Factory
}

package "Server module" {
  [SocketServer] as SS
  [ClientHandler] as CH
  [ServerProtocolHandler] as SPH
  [ServiceRegistry] as Registry
  [Services\nUser/Auction/Bid/AutoBid] as Services
  [AuctionScheduler] as Scheduler
  [ClientBroadcastHub] as Broadcast
  [DAO Layer] as DAO

  SS --> CH
  CH --> SPH
  SPH --> Registry
  Registry --> Services
  Scheduler --> Services
  Services --> DAO
  Services --> Broadcast
  Broadcast --> CH : realtime push
}

database "MySQL / Aiven" as DB

CPH --> SC : RPC request
SC <--> CH : TCP Socket / Object streams
DAO --> DB : JDBC
Client ..> Shared
Server ..> Shared
@enduml