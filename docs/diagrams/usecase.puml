@startuml
left to right direction
actor Guest
actor Bidder
actor Seller
actor Admin

rectangle "Auction System" {
  Guest -- (Register)
  Guest -- (Login)
  Guest -- (View public auctions)

  Bidder -- (View auctions)
  Bidder -- (Place bid)
  Bidder -- (Register auto-bid)
  Bidder -- (View bid history)
  Bidder -- (View price chart)
  Bidder -- (Manage wallet)

  Seller -- (Create item)
  Seller -- (Create auction session)
  Seller -- (Manage listings)
  Seller -- (View seller wallet)
  Seller -- (View auction details)

  Admin -- (View dashboard stats)
  Admin -- (Manage users)
  Admin -- (Ban/Unban user)
  Admin -- (Manage auctions/items)
  Admin -- (Delete item)
}

Bidder --|> Guest
Seller --|> Guest
Admin --|> Guest
@enduml